# Copie este arquivo para .streamlit/secrets.toml (só na sua máquina)
# ou cole o conteúdo no painel "Secrets" do Streamlit Community Cloud.
# O secrets.toml NUNCA vai para o GitHub (está no .gitignore).

[app]
# Senha única de acesso ao sistema
senha = "troque-esta-senha"
# Fuso horário usado no Histórico e nos alertas
fuso = "America/Bahia"

[planilha]
# Pode ser o link completo da planilha ou só o ID dela
url = "https://docs.google.com/spreadsheets/d/COLE_O_ID_AQUI/edit"

# Chave JSON da conta de serviço do Google Cloud.
# Abra o arquivo .json baixado no Cloud Console e copie cada campo para cá.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "gerenciador@SEU-PROJETO.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
